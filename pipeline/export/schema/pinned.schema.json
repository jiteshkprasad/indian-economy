{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {
    "additionalProperties": false,
    "properties": {
      "pins": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "total": {
        "enum": [
          "official",
          "derived"
        ]
      }
    },
    "required": [
      "total",
      "pins"
    ],
    "type": "object"
  },
  "description": "<v>/sam/pinned.json: link ids (any zoom; positive part, '~neg' part, '~pair') whose total is held to published figures (PLAN s.3.4.2). A link not listed has no official total.",
  "title": "Pinned",
  "type": "object"
}
