{
  // Live site (owner's go required for deploys and the custom domain, the owner's approval).
  "name": "indianeconomy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../out", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "routes": [{ "pattern": "indianeconomy.jitesh.app", "custom_domain": true }],
  "observability": { "enabled": true }
}
